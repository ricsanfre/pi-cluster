# Development-only external services for the k3d environment.
# Copy this file to `.env` (or let `make dev-services-up` generate it) and
# replace the empty values. `.env` is gitignored; never commit real values.
#
# RustFS root credentials
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# CNPG/Barman bucket-scoped credentials
BARMAN_ACCESS_KEY=
BARMAN_SECRET_KEY=
# Optional Vault dev-mode root token (only used with the `vault` profile)
VAULT_DEV_ROOT_TOKEN=
