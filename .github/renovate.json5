{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':skipStatusChecks',
    'github>ricsanfre/pi-cluster//.github/renovate/clusters.json5',
    'github>ricsanfre/pi-cluster//.github/renovate/customManagers.json5',
    'github>ricsanfre/pi-cluster//.github/renovate/grafanaDashboards.json5',
    'github>ricsanfre/pi-cluster//.github/renovate/groups.json5',
    'github>ricsanfre/pi-cluster//.github/renovate/labels.json5',
  ],
  dependencyDashboard: {
    title: 'Renovate Dashboard 🤖',
  },
  flux: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml$/',
    ],
  },
  helmfile: {
    managerFilePatterns: [
      '/(^|/)helmfile\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml$/',
    ],
  },
  kustomize: {
    managerFilePatterns: [
      '/(^|/)kustomization\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  pip_requirements: {
    managerFilePatterns: [
      '/(^|/)[\\w-]*requirements(-\\w+)?\\.(txt|pip)(?:\\.j2)?$/',
    ],
  },
  ansible: {
    managerFilePatterns: [
      '/(^|/)ansible/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  'ansible-galaxy': {
    managerFilePatterns: [
      '/(^|/)ansible/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  packageRules: [
    {
      description: 'kubernetes-mixin is pinned to a commit and tracked by the git-refs custom manager, not by tags',
      matchManagers: [
        'jsonnet-bundler',
      ],
      matchPackageNames: [
        'https://github.com/kubernetes-sigs/kubernetes-mixin.git',
      ],
      enabled: false,
    },
    {
      description: 'kube-prometheus publishes v-prefixed semver tags',
      matchManagers: [
        'jsonnet-bundler',
      ],
      matchPackageNames: [
        'https://github.com/prometheus-operator/kube-prometheus.git',
      ],
      versioning: 'semver-coerced',
    },
    {
      description: 'ES 9, cp-schema-registry 8 and MongoDB 9 change on-disk or wire formats: they need a migration plan and an e2e window, not a rolling upgrade',
      matchPackageNames: [
        'elastic/elasticsearch',
        'docker.io/confluentinc/cp-schema-registry',
        '/^(docker\\.io\\/library\\/)?mongo$/',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
    {
      description: [
        'Velero CLI, Ansible bootstrap pin and AWS plugin must not run ahead of the Velero Helm chart.',
        'The chart is what actually moves the Velero server and Renovate sees it under the same name',
        '(`velero`), so it is scoped out by file: helm.yaml is deliberately NOT in matchFileNames.',
        'Newest published chart is velero-12.2.5 / appVersion 1.18.2 (verified 2026-11-28) and',
        'velero-plugin-for-aws v1.15.x requires Velero v1.19.x, so a 1.19.0 PR cannot be merged yet.',
        'Do not use allowedVersions here: it would also hide 1.19.0 forever once the chart ships it.',
        'Dashboard approval keeps the update visible as a checkbox with no unmergeable PR; tick it',
        'when a chart ships appVersion 1.19.x, and verify a restore first (1.19 drops the Restic path).',
      ],
      matchFileNames: [
        '.mise.toml',
        'ansible/vars/picluster.yml',
        'kubernetes/platform/velero/app/base/values.yaml',
      ],
      matchPackageNames: [
        '/velero/',
      ],
      matchUpdateTypes: [
        'minor',
        'major',
      ],
      dependencyDashboardApproval: true,
    },
  ],
}
