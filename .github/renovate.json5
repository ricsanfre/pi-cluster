{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':skipStatusChecks',
    'github>ricsanfre/pi-cluster//.github/renovate/clusters.json5',
    'github>ricsanfre/pi-cluster//.github/renovate/customManagers.json5',
    'github>ricsanfre/pi-cluster//.github/renovate/grafanaDashboards.json5',
    'github>ricsanfre/pi-cluster//.github/renovate/groups.json5',
    'github>ricsanfre/pi-cluster//.github/renovate/labels.json5',
  ],
  dependencyDashboard: {
    title: 'Renovate Dashboard 🤖',
  },
  flux: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml$/',
    ],
  },
  helmfile: {
    managerFilePatterns: [
      '/(^|/)helmfile\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml$/',
    ],
  },
  kustomize: {
    managerFilePatterns: [
      '/(^|/)kustomization\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  pip_requirements: {
    managerFilePatterns: [
      '/(^|/)[\\w-]*requirements(-\\w+)?\\.(txt|pip)(?:\\.j2)?$/',
    ],
  },
  ansible: {
    managerFilePatterns: [
      '/(^|/)ansible/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  'ansible-galaxy': {
    managerFilePatterns: [
      '/(^|/)ansible/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  packageRules: [
    {
      description: 'kubernetes-mixin is pinned to a commit and tracked by the git-refs custom manager, not by tags',
      matchManagers: [
        'jsonnet-bundler',
      ],
      matchPackageNames: [
        'https://github.com/kubernetes-sigs/kubernetes-mixin.git',
      ],
      enabled: false,
    },
    {
      description: 'kube-prometheus publishes v-prefixed semver tags',
      matchManagers: [
        'jsonnet-bundler',
      ],
      matchPackageNames: [
        'https://github.com/prometheus-operator/kube-prometheus.git',
      ],
      versioning: 'semver-coerced',
    },
  ],
}
