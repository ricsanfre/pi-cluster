# Ansible
/ansible/roles/ricsanfre.*
/ansible/.ansible/
/ansible/ansible_collections
/ansible/certificates
/.ansible

/certs

# Terraform
/terraform/*/.terraform
/terraform/*/terraform.tfstate
/terraform/terraform.tfstate.backup
/terraform/*/tfplan
/terraform/*/.terraform.lock.hcl
/terraform/*/terraform.tfvars
/terraform/*/tfplan

# Site generated by Jekyll
/docs/_site
/docs/Gemfile.lock
/docs/vendor
/docs/.bundle
.venv
/ansible/.venv
/ansible/.uv-cache

# Metal
/metal/openwrt/config

# IDE
.vscode/
.idea/
# Planning documents (working notes, not part of the repository)
/plans/

# k3s-mixins build staging. `make k3s-mixins` writes here and then moves the
# files into base/rules/ and components/monitoring/, so this is intermediate
# output and must never be committed.
/kubernetes/platform/kube-prometheus-stack/k3s-mixins/build/out/

# Boilerplate scaffolding. `make vars-example` copies the tracked example to
# fluxcd-app-template-vars.yaml, and `make generate-fluxcd-app` writes generated
# manifests to output/. Both are local working files, never committed.
/boilerplate/output/
/boilerplate/fluxcd-app-template-vars.yaml
